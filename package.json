{
  "name": "tokray-workspace",
  "private": true,
  "version": "0.0.0",
  "packageManager": "pnpm@10.14.0",
  "description": "Tokray - open-source Agent Token efficiency and context governance. Local-first and vendor-neutral.",
  "license": "MIT",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "build": "pnpm -r --filter './packages/*' run build",
    "test": "pnpm build && pnpm -r --filter './packages/*' run test",
    "typecheck": "pnpm -r --filter './packages/*' exec tsc --noEmit",
    "start": "pnpm web",
    "web": "node packages/cli/dist/main.js web",
    "web:dev": "pnpm --filter @tokray/web dev",
    "gateway": "node packages/cli/dist/main.js gateway"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
