{
  "name": "@tokray/adapters",
  "version": "0.1.0",
  "description": "Capability-declared Tokray source adapters for Agent logs and complete API request captures.",
  "license": "MIT",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    },
    "./sdk": {
      "types": "./dist/sdk.d.ts",
      "default": "./dist/sdk.js"
    }
  },
  "files": ["dist"],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "test": "node --test"
  },
  "dependencies": {
    "@tokray/core": "workspace:*"
  },
  "devDependencies": {
    "typescript": "^5.7.0"
  }
}
