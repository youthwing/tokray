{
  "$schema": "./tokray.config.schema.json",
  "version": 1,
  "sources": [
    {
      "path": "~/.my-agent/sessions",
      "agent": "my-agent",
      "adapter": "my-agent"
    }
  ],
  "adapters": [
    {
      "version": 1,
      "id": "my-agent",
      "agent": "my-agent",
      "schemaRange": "my-agent trace v1",
      "format": "jsonl",
      "capabilities": {
        "accounting": "exact-request",
        "exactSystemPrompt": true,
        "exactToolSchemas": true,
        "exactUsage": true,
        "compaction": "none"
      },
      "agentCapabilities": {
        "readLogs": "full",
        "exactUsage": "full",
        "exactRequest": "full",
        "compactionMarkers": "none",
        "preToolHook": "none",
        "rewriteOutput": "none",
        "toolAllowlist": "none",
        "modelRouting": "none",
        "compactionControl": "none"
      },
      "detect": {
        "all": [
          { "pointer": "/event", "equals": "model_call" }
        ]
      },
      "frame": {
        "when": { "pointer": "/event", "equals": "model_call" },
        "timestamp": { "pointer": "/timestamp", "unit": "iso" },
        "model": { "pointer": "/request/model" },
        "provider": { "pointer": "/provider", "fallback": "unknown" },
        "system": { "pointer": "/request/system" },
        "messages": {
          "pointer": "/request/messages",
          "rolePointer": "/role",
          "contentPointer": "/content",
          "sourcePointer": "/name"
        },
        "tools": {
          "pointer": "/request/tools",
          "namePointer": "/name"
        },
        "usage": {
          "inputTokens": "/usage/input_tokens",
          "outputTokens": "/usage/output_tokens",
          "cacheReadTokens": "/usage/cache_read_tokens",
          "cacheWriteTokens": "/usage/cache_write_tokens",
          "inputAccounting": "includes-cache",
          "source": "log"
        }
      }
    }
  ]
}
